{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mol-infer-gnn.invalid/schemas/environment-lock.schema.json",
  "title": "Version-controlled environment lock contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "platform",
    "manager",
    "manager_version",
    "bootstrap_explicit_lock",
    "bootstrap_explicit_lock_sha256",
    "channels",
    "packages",
    "external_components",
    "scientific_execution_permitted",
    "blocking_reason"
  ],
  "properties": {
    "schema_version": {"const": "environment-lock/1"},
    "environment_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "manager": {"const": "conda"},
    "manager_version": {"type": "string", "minLength": 1},
    "bootstrap_explicit_lock": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
    },
    "bootstrap_explicit_lock_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"},
      "uniqueItems": true
    },
    "external_components": {
      "type": "array",
      "items": {"$ref": "#/$defs/external"},
      "uniqueItems": true
    },
    "scientific_execution_permitted": {"type": "boolean"},
    "blocking_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_version",
        "installation_policy",
        "license_policy"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required_version": {"type": ["string", "null"]},
        "installation_policy": {
          "enum": ["external-only", "pending-gate-c"]
        },
        "license_policy": {
          "enum": ["external-only", "not-applicable"]
        }
      }
    }
  }
}
