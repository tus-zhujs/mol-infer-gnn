{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mol-infer-gnn.invalid/schemas/solver-parameters.schema.json",
  "title": "Frozen solver parameter request and live-capture link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "engine",
    "engine_version",
    "time_limit_seconds",
    "threads",
    "parallel_mode",
    "random_seed",
    "mip_integrality_tolerance",
    "primal_feasibility_tolerance",
    "relative_mip_gap",
    "absolute_mip_gap",
    "numerical_emphasis",
    "mip_emphasis",
    "presolve",
    "warm_start",
    "parameter_display",
    "capture_all_live_parameters",
    "live_parameter_capture_sha256"
  ],
  "properties": {
    "schema_version": {"const": "solver-parameters/1"},
    "profile_id": {"type": "string", "minLength": 1},
    "engine": {"const": "CPLEX"},
    "engine_version": {"const": "22.1.1"},
    "time_limit_seconds": {"const": 3600},
    "threads": {"const": 0},
    "parallel_mode": {"const": "deterministic"},
    "random_seed": {"type": "integer", "minimum": 0},
    "mip_integrality_tolerance": {"const": "1e-9"},
    "primal_feasibility_tolerance": {"const": "1e-8"},
    "relative_mip_gap": {"const": "0"},
    "absolute_mip_gap": {"const": "0"},
    "numerical_emphasis": {"const": true},
    "mip_emphasis": {"const": 1},
    "presolve": {"enum": ["explicit-on", "explicit-off"]},
    "warm_start": {"const": false},
    "parameter_display": {"const": true},
    "capture_all_live_parameters": {"const": true},
    "live_parameter_capture_sha256": {"type": ["string", "null"], "pattern": "[0-9a-f]{64}"}
  }
}
