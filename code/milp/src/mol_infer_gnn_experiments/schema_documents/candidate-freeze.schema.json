{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mol-infer-gnn.invalid/schemas/candidate-freeze.schema.json",
  "title": "Verified-candidate population freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "campaign_manifest_sha256",
    "campaign_index_sha256",
    "canonicalization_version",
    "entries",
    "deduplication_audit_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-freeze/1"},
    "freeze_id": {"type": "string", "minLength": 1},
    "campaign_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_index_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"},
      "uniqueItems": true
    },
    "deduplication_audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "graph_sha256",
        "canonical_graph_sha256",
        "sdf_sha256",
        "source_conditions"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_graph_sha256": {"$ref": "#/$defs/sha256"},
        "sdf_sha256": {"$ref": "#/$defs/sha256"},
        "source_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition_id", "attempt_id", "verification_sha256"],
            "properties": {
              "condition_id": {"type": "string", "minLength": 1},
              "attempt_id": {"type": "string", "pattern": "attempt-[0-9]{4}"},
              "verification_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "uniqueItems": true
        }
      }
    }
  }
}
