{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mol-infer-gnn.invalid/schemas/phase1-inference-input.schema.json",
  "title": "Direct Phase 1 graph inference input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "molecule_id", "node_features", "edge_index"],
  "properties": {
    "schema_version": {"const": "phase1-inference-input/1"},
    "molecule_id": {"type": "string", "minLength": 1},
    "node_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    },
    "edge_index": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0}
      }
    },
    "fringe_node_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 14,
        "maxItems": 14,
        "items": {"type": "number"}
      }
    },
    "fringe_edge_index": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0}
      }
    },
    "fringe_batch": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "interior_fringe_index": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "interior_batch": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
